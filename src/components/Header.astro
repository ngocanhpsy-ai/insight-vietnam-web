            </div>
        </div>
    </div>
</header>

<style>
    /* ========================================= */
    /* CẤU TRÚC HEADER TỔNG THỂ                  */
    /* ========================================= */
    .site-header {
        width: 100%;
        padding: 40px 20px 0 20px; 
        box-sizing: border-box;
        position: relative;
        z-index: 1000; 
    }
    
    .header-container {
        width: 100%;
        max-width: 900px; 
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: flex-end; 
    }

    .header-side {
        flex: 1; 
        display: flex;
        padding-bottom: 12px; 
    }
    .header-side.right {
        justify-content: flex-end;
    }

    /* -- NGÔN NGỮ -- */
    .header-lang {
        font-family: "Helvetica Now", Arial, sans-serif;
        font-size: 0.95rem;
        font-weight: bold;
    }
    .header-lang a {
        color: #2b0c06;
        text-decoration: none;
        opacity: 0.5;
        transition: opacity 0.2s;
    }
    .header-lang a.active, .header-lang a:hover { opacity: 1; }
    .header-lang .divider { margin: 0 5px; opacity: 0.5; }

    /* -- MENU CHÍNH VÀ CÁC THẺ TAB -- */
    .header-nav {
        display: flex;
        gap: 5px; 
    }

    /* ĐỊNH DẠNG TAB CHUNG */
    .nav-btn {
        color: #f8f8ee;
        text-decoration: none;
        padding: 12px 22px;
        border-radius: 12px 12px 0 0; 
        font-family: "Helvetica Now", Arial, sans-serif;
        font-weight: bold;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        margin: 0; 
    }
    
    /* GÁN MÀU RIÊNG CHO TỪNG TAB */
    .bg-gioi-thieu { background-color: #36211e; }
    .bg-du-an { background-color: #36211e; }
    .bg-dich-vu { background-color: #36211e; }
    .bg-lien-he { background-color: #36211e; }
    .bg-chia-se { background-color: #36211e; }

    /* HIỆU ỨNG DI CHUỘT */
    .nav-btn.active, .nav-btn:hover {
        filter: brightness(1.15); 
    }

    /* -- MẠNG XÃ HỘI -- */
    .header-social {
        display: flex;
        gap: 15px;
    }
    .header-social a {
        color: #2b0c06;
        width: 22px;
        height: 22px;
        transition: transform 0.2s;
        display: flex;
    }
    .header-social a:hover {
        transform: translateY(-3px);
    }

    /* ========================================= */
    /* MENU THẢ XUỐNG DỊCH VỤ                    */
    /* ========================================= */
    .dropdown-container {
        position: relative;
        display: flex; 
    }

    .drop-btn {
        gap: 8px;
    }

    .dropdown-icon {
        width: 14px;
        height: 14px;
        transition: transform 0.3s ease;
    }

    .dropdown-container:hover .dropdown-icon {
        transform: rotate(180deg);
    }

    .dropdown-content {
        visibility: hidden;
        opacity: 0;
        position: absolute;
        top: 100%;
        left: 50%;
        transform: translateX(-50%) translateY(15px);
        background-color: #f6eedc; 
        min-width: 380px; 
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        z-index: 100;
        border-radius: 12px;
        border: 1px solid rgba(43, 12, 6, 0.15);
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .dropdown-container:hover .dropdown-content {
        visibility: visible;
        opacity: 1;
        transform: translateX(-50%) translateY(0); 
    }

    .dropdown-item {
        color: #2b0c06 !important; 
        padding: 20px 25px !important;
        text-decoration: none;
        display: block; 
        font-family: inherit;
        font-weight: bold;
        font-size: 0.95rem;
        line-height: 1.5;
        border-bottom: 1px solid rgba(43, 12, 6, 0.1);
        text-align: left;
        background-color: transparent !important;
        transition: all 0.2s ease !important;
    }

    .dropdown-item:last-child {
        border-bottom: none;
    }

    .dropdown-item:hover {
        background-color: #2b0c06 !important;
        color: #f6eedc !important;
    }

    /* Tương thích giao diện điện thoại */
    @media (max-width: 900px) {
        .header-container { flex-direction: column; gap: 20px; align-items: center; }
        .header-side { padding-bottom: 0; }
        .header-nav { flex-wrap: wrap; justify-content: center; }
        .nav-btn { border-radius: 8px; } 
    }
</style>