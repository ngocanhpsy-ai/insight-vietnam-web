---
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
    <div class="header-container">
        <!-- BÊN TRÁI: NGÔN NGỮ -->
        <div class="header-side left">
            <div class="header-lang">
                <a href="#" class="active">VIE</a> <span class="divider">|</span> <a href="#">ENG</a>
            </div>
        </div>

        <!-- Ở GIỮA: MENU CHÍNH CÁC TAB -->
        <nav class="header-nav">
            <a href="/" class="nav-btn bg-gioi-thieu active">Giới Thiệu</a>
            <a href="/case-studies" class="nav-btn bg-du-an">Dự Án</a>
            
            <!-- MENU THẢ XUỐNG DỊCH VỤ -->
            <div class="dropdown-container">
                <!-- ĐÃ SỬA LẠI ĐƯỜNG DẪN THÀNH /service -->
                <button class="nav-btn drop-btn bg-dich-vu" onclick="window.location.href='/service'">
                    Dịch Vụ
                    <svg class="dropdown-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
                
                <div class="dropdown-content">
                    <!-- ĐÃ SỬA LẠI ĐƯỜNG DẪN THÀNH /service -->
                    <a href="/service" class="dropdown-item">
                        Các gói tư vấn tăng trưởng
                    </a>
                    <a href="/training" class="dropdown-item">
                        Đào tạo dữ liệu chuyên sâu cho Founders và cấp Quản lý
                    </a>
                </div>
            </div>

            <a href="/contact" class="nav-btn bg-lien-he">Liên Hệ</a>
            <a href="/events" class="nav-btn bg-chia-se">Chia Sẻ Kiến Thức</a>
        </nav>

        <!-- BÊN PHẢI: MẠNG XÃ HỘI (Icon Solid đặc) -->
