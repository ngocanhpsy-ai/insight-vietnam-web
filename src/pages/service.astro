---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="vi">
    <head>
        <BaseHead title={`Dịch Vụ - ${SITE_TITLE}`} description="Các gói dịch vụ tư vấn chiến lược, chẩn đoán tệp khách hàng và định vị thương hiệu từ Insight Vietnam." />
        
        <style is:global>
            html, body {
                color: #2b0c06;
                font-family: "Helvetica World", Arial, sans-serif;
                margin: 0;
                padding: 0;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                background-color: #27201a;
            }

            body::before {
                content: "";
                position: fixed;
                top: 0; left: 0; right: 0; bottom: 0;
                background-image: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)), url('/ws_background_8.jpg');
                background-size: 120% 120%; 
                background-position: left center;
                background-repeat: no-repeat;
                z-index: 0;
                animation: panBackground 40s linear infinite alternate; 
            }

            @keyframes panBackground {
                0% { background-position: 0% 50%; }
                100% { background-position: 100% 50%; }
            }
        </style>
        
        <style>
            main {
                flex: 1;
                width: 100%;
                max-width: 900px; 
                margin: 0 auto;
                background-color: rgba(248, 248, 238, 0.6); 
                backdrop-filter: blur(8px);
                box-shadow: 0px -5px 25px rgba(0,0,0,0.4);
                position: relative;
                z-index: 2; 
                display: flex;
                flex-direction: column;
                padding: 50px 40px 80px 40px; 
                box-sizing: border-box;
                min-height: 85vh;
            }
            
            .services-intro {
                font-size: 1.15rem;
                line-height: 1.8;
                margin-bottom: 45px;
                margin-top: 10px;
                color: #2b0c06;
                padding-bottom: 30px;
                border-bottom: 1px dashed rgba(43, 12, 6, 0.3);
            }
            
            .services-intro p { margin: 0; }
            
            .services-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 25px; 
                flex: 1;
            }
            
            .services-grid.has-open-card { display: block; }
            .services-grid.has-open-card .service-card:not(.is-open) { display: none; }

            .service-card {
                width: 100%;
                border-radius: 12px;
                padding: 25px 25px 35px 25px; 
                box-sizing: border-box;
                box-shadow: 0 4px 15px rgba(0,0,0,0.1);
                display: flex;
                flex-direction: column;
                text-align: left;
                height: 100%;
                cursor: pointer;
                position: relative;
                transition: transform 0.2s ease, box-shadow 0.2s ease, padding 0.4s ease;
            }
            .service-card:hover { transform: translateY(-5px); box-shadow: 0 10px 25px rgba(0,0,0,0.15); }

            .service-card.is-open {
                cursor: default;
                transform: none; 
                padding: 50px 50px 60px 50px; 
                box-shadow: 0 15px 40px rgba(0,0,0,0.3);
                animation: drawCard 0.4s cubic-bezier(0.25, 1, 0.5, 1) forwards;
            }
            @keyframes drawCard {
                0% { opacity: 0; transform: scale(0.95) translateY(20px); }
                100% { opacity: 1; transform: scale(1) translateY(0); }
            }

            .close-btn {
                display: none;
                position: absolute;
                top: 25px; right: 25px;
                background: transparent;
                border: 2px solid currentColor;
                border-radius: 50%;
                width: 35px; height: 35px;
                font-size: 1.5rem; line-height: 0;
                color: inherit; cursor: pointer;
                opacity: 0.6; transition: all 0.2s; z-index: 10;
            }
            .service-card.is-open .close-btn { display: flex; justify-content: center; align-items: center; }
            .close-btn:hover { opacity: 1; transform: scale(1.1); }

            .theme-light { background-color: #f6eedc; color: #3b1712; }
            .theme-dark { background-color: #310e08; color: #f6eedc; }

            .card-title-area { margin-bottom: 15px; }
            .card-number { font-size: 2.2rem; font-family: "Helvetica Now", Arial, sans-serif; margin: 0; line-height: 1; transition: all 0.3s; }
            .card-question { font-size: 1.05rem; font-family: "Helvetica Now", Arial, sans-serif; font-weight: bold; text-transform: uppercase; margin: 10px 0 0 0; line-height: 1.35; min-height: 4rem; transition: all 0.3s; }
            .package-subtitle { font-size: 0.85rem; margin-bottom: 5px; font-weight: bold; opacity: 0.9; transition: all 0.3s; }
            .service-fieldset { border: 1.5px solid currentColor; border-radius: 0 20px 20px 20px; padding: 15px; margin: 0; flex: 1; transition: all 0.3s; }
            .service-legend { font-family: "Helvetica Now", Arial, sans-serif; font-size: 1.05rem; font-weight: bold; padding-right: 15px; text-transform: uppercase; transition: all 0.3s; }
            .service-desc { font-size: 0.85rem; line-height: 1.5; margin-bottom: 15px; transition: all 0.3s; }
            .service-list { list-style: none; padding: 0; margin: 0 0 20px 0; }
            .service-list li { font-size: 0.85rem; line-height: 1.4; margin-bottom: 8px; display: flex; gap: 8px; transition: all 0.3s; }
            .service-metrics { display: flex; flex-direction: column; gap: 10px; font-size: 0.85rem; font-weight: bold; transition: all 0.3s; }
            .metric-item { display: flex; align-items: center; gap: 10px; }
            .metric-icon { width: 20px; height: 20px; border: 1.5px solid currentColor; border-radius: 50%; display: flex; justify-content: center; align-items: center; flex-shrink: 0; transition: all 0.3s; }
            .metric-svg { width: 12px; height: 12px; }
            .service-note { font-size: 0.75rem; font-style: italic; margin-top: 15px; opacity: 0.9; transition: all 0.3s; }

            .service-card.is-open .card-number { font-size: 3.5rem; }
            .service-card.is-open .card-question { font-size: 1.5rem; min-height: auto; margin-bottom: 20px; }
            .service-card.is-open .package-subtitle { font-size: 1.05rem; }
            .service-card.is-open .service-fieldset { border-radius: 0 30px 30px 30px; padding: 30px; }
            .service-card.is-open .service-legend { font-size: 1.35rem; }
            .service-card.is-open .service-desc { font-size: 1.05rem; line-height: 1.6; margin-bottom: 25px; }
            .service-card.is-open .service-list li { font-size: 1rem; line-height: 1.5; margin-bottom: 12px; gap: 10px; }
            .service-card.is-open .service-metrics { gap: 15px; font-size: 1.05rem; }
            .service-card.is-open .metric-icon { width: 26px; height: 26px; }
            .service-card.is-open .metric-svg { width: 14px; height: 14px; }
            .service-card.is-open .service-note { font-size: 0.9rem; margin-top: 20px; }

            /* NÚT CTA VÀ POPUP FORM */
            .cta-container {
                text-align: center; margin-top: 60px; padding-top: 40px;
                border-top: 1px dashed rgba(43, 12, 6, 0.3);
            }
            .btn-cta {
                display: inline-block; background-color: #531c24; color: #f8f8ee;
                font-family: inherit; font-size: 1.1rem; font-weight: bold;
                padding: 15px 40px; border: none; border-radius: 50px;
                cursor: pointer; transition: all 0.3s ease;
                box-shadow: 0 4px 15px rgba(83, 28, 36, 0.3);
            }
            .btn-cta:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(83, 28, 36, 0.4); }

            .modal-overlay {
                position: fixed; top: 0; left: 0; right: 0; bottom: 0;
                background-color: rgba(0,0,0,0.6); display: flex; justify-content: center; align-items: center;
                z-index: 9999; visibility: hidden; opacity: 0;
                transition: all 0.3s ease; backdrop-filter: blur(3px);
            }
            .modal-overlay.show { visibility: visible; opacity: 1; }
            
            .modal-content {
                background-color: #f6eedc; padding: 40px; border-radius: 12px;
                box-shadow: 0 15px 40px rgba(0,0,0,0.3); max-width: 450px; width: 90%;
                border: 2px solid #2b0c06; position: relative;
                transform: translateY(20px); transition: transform 0.3s ease;
            }
            .modal-overlay.show .modal-content { transform: translateY(0); }

            .close-modal {
                position: absolute; top: 15px; right: 20px;
                background: none; border: none; font-size: 1.5rem;
                cursor: pointer; color: #2b0c06;
            }
            .modal-title {
                font-family: "Helvetica Now", Arial, sans-serif; font-size: 1.3rem;
                margin-top: 0; margin-bottom: 25px; color: #531c24;
                text-align: center; text-transform: uppercase;
            }

            .booking-form { display: flex; flex-direction: column; gap: 15px; }
            .booking-form input, .booking-form select {
                font-family: inherit; font-size: 1rem; padding: 12px 15px;
                background-color: rgba(255,255,255,0.5); border: 1px solid rgba(43, 12, 6, 0.3);
                border-radius: 8px; color: #2b0c06; transition: border-color 0.3s;
            }
            .booking-form input:focus, .booking-form select:focus { outline: none; border-color: #531c24; }
            
            /* CSS RIÊNG CHO HÀNG NGÀY & GIỜ */
            .datetime-row { display: flex; gap: 15px; }
            .datetime-row input, .datetime-row select { flex: 1; color-scheme: light; }
            .datetime-row select {
                appearance: none;
                background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%232b0c06%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
                background-repeat: no-repeat; background-position: right 15px top 50%; background-size: 12px auto;
            }

            .btn-submit {
                background-color: #2b0c06; color: #f8f8ee; border: none;
                padding: 15px 0; font-family: inherit; font-weight: bold; font-size: 1.05rem;
                border-radius: 8px; cursor: pointer; margin-top: 10px; transition: all 0.3s ease;
            }
            .btn-submit:hover { background-color: #531c24; }

            @media (max-width: 768px) {
                main { padding: 30px 20px 60px 20px; }
                .services-grid { grid-template-columns: 1fr; }
                .service-card, .service-card.is-open { padding: 30px 20px; }
                .datetime-row { flex-direction: column; gap: 15px; }
            }
        </style>
    </head>
    
    <body>
        <Header />
        
        <main>
            <div class="services-intro">
                <p>Chúng tôi giúp các doanh nghiệp vừa và nhỏ hiểu về <strong>khách hàng</strong> của mình, <strong>thương hiệu</strong> của mình, <strong>thị trường</strong> của mình và <strong>địa điểm</strong> mở bán phù hợp với mình.</p>
            </div>
            
            <div class="services-grid" id="serviceGrid">
                <!-- THẺ 01 -->
                <div class="service-card theme-light">
                    <button class="close-btn" aria-label="Đóng thẻ">&times;</button>
                    <div class="card-title-area">
                        <h2 class="card-number">01</h2>
                        <h3 class="card-question">Tại sao chuyển đổi khách lại khó khăn đến vậy?</h3>
                    </div>
                    <p class="package-subtitle">GÓI TĂNG TRƯỞNG A1</p>
                    <fieldset class="service-fieldset">
                        <legend class="service-legend">Chẩn đoán tệp khách hàng</legend>
                        <p class="service-desc">Nếu không có khách hàng - sẽ không có doanh nghiệp. Gói dịch vụ giúp bạn xác định rõ tệp khách hàng thật sự sẵn sàng chi trả cho dịch vụ và sản phẩm của bạn: chân dung và thói quen tiêu dùng, nỗi đau, động cơ mua hàng và các điểm rơi tâm lý khiến tệp này chưa chuyển đổi hoặc rời bỏ.</p>
                        <ul class="service-list">
                            <li><strong>01//</strong> <span>Báo cáo kết quả phân tích tệp khách hàng lõi</span></li>
                            <li><strong>02//</strong> <span>Bàn giao toàn bộ dữ liệu lõi đã được làm sạch, định dạng theo yêu cầu</span></li>
                            <li><strong>03//</strong> <span>Họp phản biện để hoàn thiện chân dung cuối cùng và phương án tăng tỷ lệ chuyển đổi</span></li>
                            <li><strong>04//</strong> <span>1 buổi họp follow-up hiệu quả các chiến lược đưa ra</span></li>
                        </ul>
                        <div class="service-metrics">
                            <div class="metric-item"><div class="metric-icon"><svg class="metric-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div> Thời gian: 2 - 3 tuần</div>
                            <div class="metric-item"><div class="metric-icon">$</div> Giá gói: 15,000,000+</div>
                        </div>
                    </fieldset>
                </div>

                <!-- THẺ 02 -->
                <div class="service-card theme-dark">
                    <button class="close-btn" aria-label="Đóng thẻ">&times;</button>
                    <div class="card-title-area">
                        <h2 class="card-number">02</h2>
                        <h3 class="card-question">Làm thế nào để tăng sức cạnh tranh?</h3>
                    </div>
                    <p class="package-subtitle">GÓI TĂNG TRƯỞNG A2</p>
                    <fieldset class="service-fieldset">
                        <legend class="service-legend">Chẩn đoán thương hiệu</legend>
                        <p class="service-desc">Định vị thương hiệu và lợi thế cạnh tranh giúp bạn biết vì sao và làm thế nào để khách hàng chọn bạn thay vì những đối thủ khác trên thị trường. Gói dịch vụ giúp bạn xác định: khách hàng lựa chọn bạn để phục vụ cho nhu cầu tâm lý nào, bạn đang thực sự cạnh tranh trực tiếp với những ai, giống và khác biệt với họ ở những điểm nào, và còn những khoảng trống nào trên thị trường bạn có thể chiếm lĩnh.</p>
                        <ul class="service-list">
                            <li><strong>01//</strong> <span>Báo cáo về định vị thương hiệu và lợi thế cạnh tranh</span></li>
                            <li><strong>02//</strong> <span>Phân tích 2-3 đối thủ cạnh tranh trực tiếp: điểm giống, điểm khác biệt và phương án cạnh tranh</span></li>
                            <li><strong>03//</strong> <span>Họp phản biện về kết quả phân tích</span></li>
                            <li><strong>04//</strong> <span>Bàn giao toàn bộ dữ liệu lõi đã được làm sạch, định dạng theo yêu cầu</span></li>
                            <li><strong>05//</strong> <span>1 buổi họp follow-up hiệu quả</span></li>
                        </ul>
                        <div class="service-metrics">
                            <div class="metric-item"><div class="metric-icon"><svg class="metric-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div> Thời gian: 1-2 tháng</div>
                            <div class="metric-item"><div class="metric-icon">$</div> Giá gói: 40,000,000+</div>
                        </div>
                    </fieldset>
                </div>

                <!-- THẺ 03 -->
                <div class="service-card theme-light">
                    <button class="close-btn" aria-label="Đóng thẻ">&times;</button>
                    <div class="card-title-area">
                        <h2 class="card-number">03</h2>
                        <h3 class="card-question">Vị trí nào phù hợp nhất để mở cửa hàng?</h3>
                    </div>
                    <p class="package-subtitle">GÓI TĂNG TRƯỞNG B1</p>
                    <fieldset class="service-fieldset">
                        <legend class="service-legend">Xác định địa điểm</legend>
                        <p class="service-desc">Vị trí là yếu tố quyết định việc bạn có thể tiếp cận tệp khách hàng phù hợp dễ dàng hay không, nhất là trong các ngành dịch vụ, thời trang và bán lẻ. Gói dịch vụ giúp bạn xác định rõ: nơi nào tiếp cận dễ dàng nhất tệp khách hàng lõi, có không gian, thói quen tiêu dùng và mật độ cạnh tranh phù hợp với thương hiệu và giảm thiểu rủi ro chia khách.</p>
                        <ul class="service-list">
                            <li><strong>01//</strong> <span>Báo cáo về chẩn đoán tệp khách hàng</span></li>
                            <li><strong>02//</strong> <span>Báo cáo quy mô thị trường và dư địa tăng trưởng</span></li>
                            <li><strong>03//</strong> <span>Phân tích 3-5 địa điểm phù hợp nhất</span></li>
                            <li><strong>04//</strong> <span>Họp phản biện để hoàn thiện việc xác định địa điểm mở rộng</span></li>
                            <li><strong>05//</strong> <span>Bàn giao toàn bộ dữ liệu lõi đã được làm sạch, định dạng theo yêu cầu</span></li>
                            <li><strong>06//</strong> <span>1 buổi họp follow-up</span></li>
                        </ul>
                        <div class="service-metrics">
                            <div class="metric-item"><div class="metric-icon"><svg class="metric-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div> Thời gian: 2-3 tháng</div>
                            <div class="metric-item"><div class="metric-icon">$</div> Giá gói: 70,000,000+</div>
                        </div>
                    </fieldset>
                </div>

                <!-- THẺ 04 -->
                <div class="service-card theme-dark">
                    <button class="close-btn" aria-label="Đóng thẻ">&times;</button>
                    <div class="card-title-area">
                        <h2 class="card-number">04</h2>
                        <h3 class="card-question">Muốn tăng trưởng nhưng lo đứt gãy dòng tiền?</h3>
                    </div>
                    <p class="package-subtitle">GÓI TĂNG TRƯỞNG B2</p>
                    <fieldset class="service-fieldset">
                        <legend class="service-legend">Kịch bản tăng trưởng</legend>
                        <p class="service-desc">Doanh nghiệp nào cũng mong muốn mở rộng kinh doanh nhưng đây cũng là thời điểm dòng tiền dễ bị đứt gãy nhất. Gói dịch vụ* giúp bạn xác định rõ khả năng mở rộng đến đâu dựa trên vốn hiện có và quy mô thị trường, cần bao nhiêu vốn để mở rộng, điểm hoà vốn, thời điểm hoà vốn, các rủi ro để tránh đứt gãy dòng tiền.</p>
                        <ul class="service-list">
                            <li><strong>01//</strong> <span>Báo cáo phân tích quy mô thị trường và dư địa tăng trưởng</span></li>
                            <li><strong>02//</strong> <span>Bộ rà soát năng lực: vận hành, nhân sự, chi phí, cung ứng</span></li>
                            <li><strong>03//</strong> <span>3 Kịch bản mở rộng: khả thi, dòng tiền và điểm hoà vốn trong 3-5 năm</span></li>
                            <li><strong>04//</strong> <span>Họp phản biện để hoàn thiện kịch bản</span></li>
                            <li><strong>05//</strong> <span>Bàn giao toàn bộ dữ liệu lõi đã được làm sạch</span></li>
                            <li><strong>06//</strong> <span>1 buổi họp follow-up hiệu quả</span></li>
                        </ul>
                        <div class="service-metrics">
                            <div class="metric-item"><div class="metric-icon"><svg class="metric-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div> Thời gian: 2-3 tháng</div>
                            <div class="metric-item"><div class="metric-icon">$</div> Giá gói: tuỳ quy mô doanh nghiệp</div>
                        </div>
                        <p class="service-note">*Gói dịch vụ phối hợp với đơn vị tư vấn tối ưu chi phí và vận hành</p>
                    </fieldset>
                </div>
            </div>
            
            <div class="cta-container">
                <button class="btn-cta" id="openModalBtn">Đặt lịch tìm hiểu dịch vụ tư vấn tại Đây</button>
            </div>
            
            <div style="flex: 1;"></div>
            <Footer />
        </main>

        <!-- POPUP ĐẶT LỊCH KÈM TÍNH NĂNG CHỌN NGÀY GIỜ -->
        <div class="modal-overlay" id="bookingModal">
            <div class="modal-content">
                <button class="close-modal" id="closeModalBtn">&times;</button>
                <h3 class="modal-title">Đặt lịch tư vấn</h3>
                
                <form id="serviceForm" class="booking-form">
                    <!-- THAY MÃ ACCESS KEY CỦA BẠN VÀO ĐÂY -->
                    <input type="hidden" name="access_key" value="DÁN_MÃ_ACCESS_KEY_CỦA_BẠN_VÀO_ĐÂY">
                    <input type="hidden" name="subject" value="[DỊCH VỤ] Đặt lịch tìm hiểu gói tư vấn">
                    <input type="hidden" name="from_name" value="Insight Vietnam">

                    <input type="text" name="name" placeholder="Họ và Tên *" required>
                    <input type="text" name="company" placeholder="Công ty / Doanh nghiệp">
                    <input type="email" name="email" placeholder="Địa chỉ Email *" required>
                    <input type="tel" name="phone" placeholder="Số điện thoại liên hệ *" required>
                    
                    <div class="datetime-row">
                        <input type="date" name="preferred_date" id="serviceBookDate" required title="Chọn ngày (trong 3 tuần tới)">
                        <select name="preferred_time" required>
                            <option value="" disabled selected>Khung giờ *</option>
                            <option value="Sáng (09:00 - 11:30)">14:00 - 16:00</option>
                            <option value="Chiều (14:00 - 17:00)">16:00 - 18:00</option>
                        </select>
                    </div>
                    
                    <button type="submit" class="btn-submit">Gửi Yêu Cầu</button>
                </form>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                // LOGIC LẬT THẺ
                const grid = document.getElementById('serviceGrid');
                const cards = document.querySelectorAll('.service-card');
                const closeBtns = document.querySelectorAll('.close-btn');

                cards.forEach(card => {
                    card.addEventListener('click', (e) => {
                        if (e.target.closest('.close-btn')) return;
                        if (!card.classList.contains('is-open')) {
                            grid.classList.add('has-open-card');
                            card.classList.add('is-open');
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        }
                    });
                });

                closeBtns.forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const card = btn.closest('.service-card');
                        grid.classList.remove('has-open-card');
                        card.classList.remove('is-open');
                    });
                });

                // LOGIC HỘP THOẠI MODAL ĐẶT LỊCH
                const modal = document.getElementById('bookingModal');
                const openBtn = document.getElementById('openModalBtn');
                const modalCloseBtn = document.getElementById('closeModalBtn');
                
                openBtn.addEventListener('click', () => modal.classList.add('show'));
                modalCloseBtn.addEventListener('click', () => modal.classList.remove('show'));
                modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('show'); });

                // LOGIC GIỚI HẠN NGÀY ĐẶT LỊCH (21 Ngày tới)
                const dateInput = document.getElementById('serviceBookDate');
                if(dateInput) {
                    const today = new Date();
                    const maxDate = new Date();
                    maxDate.setDate(today.getDate() + 21);
                    const formatDate = (date) => date.toISOString().split('T')[0];
                    dateInput.min = formatDate(today);
                    dateInput.max = formatDate(maxDate);
                }

                // LOGIC GỬI FORM WEB3FORMS
                const form = document.getElementById('serviceForm');
                if (form) {
                    const submitBtn = form.querySelector('.btn-submit');
                    form.addEventListener('submit', async (e) => {
                        e.preventDefault(); 
                        const formData = new FormData(form);
                        const object = Object.fromEntries(formData);
                        const json = JSON.stringify(object);

                        const originalText = submitBtn.innerText;
                        submitBtn.innerText = 'Đang gửi...';
                        submitBtn.disabled = true;

                        try {
                            const response = await fetch('https://api.web3forms.com/submit', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                body: json
                            });
                            if (response.status === 200) {
                                alert('Cám ơn bạn đã gửi yêu cầu! Insight Vietnam sẽ liên hệ với bạn trong thời gian sớm nhất.');
                                form.reset();
                                modal.classList.remove('show');
                            } else {
                                alert('Xin lỗi, có lỗi xảy ra. Vui lòng thử lại sau.');
                            }
                        } catch (error) {
                            alert('Xin lỗi, đã mất kết nối. Vui lòng thử lại sau.');
                        } finally {
                            submitBtn.innerText = originalText;
                            submitBtn.disabled = false;
                        }
                    });
                }
            });
        </script>
    </body>
</html>