        </div>
        
    </div>
</header>

<style>
    .site-header { width: 100%; background-color: transparent; padding-top: 40px; position: relative; z-index: 10; }
    
    .header-container {
        max-width: 900px;
        margin: 0 auto;
        position: relative; 
        display: flex;
        justify-content: center; 
        align-items: flex-end; 
    }
    
    /* Thiết kế nút chuyển ngôn ngữ */
    .lang-switch {
        position: absolute;
        left: 20px;
        bottom: 12px;
        font-family: "Helvetica Now", Arial, sans-serif;
        font-weight: bold;
        color: #2b0c06;
        font-size: 0.95rem;
    }
    .lang-switch a {
        text-decoration: none;
        color: rgba(43, 12, 6, 0.5); /* Màu mờ cho ngôn ngữ không được chọn */
        transition: color 0.2s;
    }
    .lang-switch a.active, .lang-switch a:hover {
        color: #2b0c06; /* Màu đậm cho ngôn ngữ đang chọn */
    }

    .tabs-nav { display: flex; gap: 6px; } /* Giảm nhẹ khoảng cách giữa các tab */
    
    .tab {
        padding: 12px 18px 16px; /* Giảm nhẹ padding để nhét vừa 5 tab */
        text-decoration: none; color: #f8f8ee; font-family: "Helvetica World", Arial, sans-serif;
        font-weight: bold; font-size: 1rem; /* Giảm nhẹ font size */
        border-radius: 12px 12px 0 0;
        margin-bottom: -1px; position: relative; z-index: 3; transition: transform 0.2s ease;
    }
    .tab:hover { transform: translateY(-4px); }

    /* Bảng màu phân bổ cho 5 Tabs */
    .tab-1 { background-color: #5c4945; }
    .tab-2 { background-color: #312b29; }
    .tab-3 { background-color: #531c24; } /* Màu đỏ mận cho Dịch vụ như trong ảnh */
    .tab-4 { background-color: #8c7875; }
    .tab-5 { background-color: #4a3b38; } /* Màu nâu sẫm cho Sự kiện */

    .social-links { 
        position: absolute; 
        right: 20px; 
        bottom: 12px;
        display: flex; gap: 12px; 
    }
    .social-links a { color: #2b0c06; transition: opacity 0.2s; }
    .social-links a:hover { opacity: 0.6; }
</style>