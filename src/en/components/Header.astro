---
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
    <div class="header-container">
        
        <!-- Nút chuyển ngôn ngữ (Nằm sát lề trái) -->
        <div class="lang-switch">
            <a href="/" class="active">VIE</a> | <a href="/en">ENG</a>
        </div>

        <!-- 5 Tabs (Nằm chính giữa) -->
        <nav class="tabs-nav">
            <a href="/about" class="tab tab-1">Về Tôi</a>
            <a href="/case-studies" class="tab tab-2">Case Studies</a>
            <a href="/service" class="tab tab-3">Dịch Vụ</a>
            <a href="/contact" class="tab tab-4">Liên Hệ</a>
            <a href="/events" class="tab tab-5">Sự Kiện</a>
        </nav>
        
        <!-- 3 Icons Mạng xã hội (Nằm sát lề phải) -->
        <div class="social-links">
            <a href="https://www.facebook.com/insightlabvietnam/" target="_blank" title="Facebook">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
